{
  "manifest_version": 3,
  "name": "Prism — Инспектор дизайна",
  "short_name": "Prism",
  "description": "Мгновенный разбор цветов, шрифтов и SVG-логотипов любого сайта.",
  "version": "1.0.0",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Prism",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}